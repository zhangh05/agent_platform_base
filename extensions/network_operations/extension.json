{
  "extension_id": "network.operations",
  "name": "网络设备与 Skill",
  "version": "2.3.0",
  "api_version": "1",
  "min_platform_version": "1.1.0",
  "description": "以授权设备连接为基础，提供自主 CLI、巡检与 Skill 编排；已发布并选择的 Skill 可直接执行设备配置。",
  "capabilities": ["network_devices", "network_connections", "network_skills", "network_cli_runtime", "semantic_collection", "network_inspection", "operational_context", "confirmed_references"],
  "tools": [
    "network.operations.devices_read",
    "network.operations.skills_read",
    "network.operations.context_read",
    "network.operations.device.manage",
    "network.operations.inspection"
  ],
  "permissions": ["workspace:read", "workspace:write", "network:network"],
  "routes": [
    "/api/extensions/network.operations/regions",
    "/api/extensions/network.operations/regions/<region_id>",
    "/api/extensions/network.operations/devices",
    "/api/extensions/network.operations/devices/<device_id>",
    "/api/extensions/network.operations/connections",
    "/api/extensions/network.operations/connections/<connection_id>",
    "/api/extensions/network.operations/connections/<connection_id>/test",
    "/api/extensions/network.operations/skills",
    "/api/extensions/network.operations/skills/<skill_id>",
    "/api/extensions/network.operations/inspections",
    "/api/extensions/network.operations/inspections/<task_id>",
    "/api/extensions/network.operations/inspections/<task_id>/cancel",
    "/api/extensions/network.operations/inspections/<task_id>/evidence",
    "/api/extensions/network.operations/inspections/<task_id>/retry",
    "/api/extensions/network.operations/context",
    "/api/extensions/network.operations/references/batch-delete",
    "/api/extensions/network.operations/references/<reference_id>",
    "/api/extensions/network.operations/observations/batch-delete",
    "/api/extensions/network.operations/observations/<observation_id>",
    "/api/extensions/network.operations/command-experience/batch-delete",
    "/api/extensions/network.operations/command-experience/<experience_id>",
    "/api/extensions/network.operations/scripts",
    "/api/extensions/network.operations/scripts/<script_id>"
  ],
  "frontend_modules": ["frontend/NetworkOperations.tsx"],
  "workflow_templates": [],
  "frontend_routes": [
    {
      "path": "/extensions/network.operations/manage",
      "module": "frontend/NetworkOperations.tsx",
      "label": "网络设备与 Skill",
      "description": "登记设备、验证连接并配置工作台 Skill",
      "icon": "probe",
      "order": 30
    }
  ],
  "entrypoint": "backend.py:register",
  "metadata": {
    "minimum_role": "viewer",
    "minimum_write_role": "operator",
    "quotas": {"max_concurrency": 5, "max_devices": 1000}
  }
}
