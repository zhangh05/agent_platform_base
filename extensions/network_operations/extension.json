{
  "extension_id": "network.operations",
  "name": "网络巡检",
  "version": "1.1.0",
  "api_version": "1",
  "min_platform_version": "1.1.0",
  "description": "工作区级设备资产、只读 SSH 巡检、证据、状态基线与差异。",
  "capabilities": ["network_assets", "network_inspection", "network_baseline"],
  "tools": [
    "network.operations.assets_read",
    "network.operations.assets_write",
    "network.operations.inspection",
    "network.operations.baseline"
  ],
  "permissions": ["workspace:read", "workspace:write", "network:network"],
  "routes": [
    "/api/extensions/network.operations/overview",
    "/api/extensions/network.operations/assets",
    "/api/extensions/network.operations/assets/<asset_id>",
    "/api/extensions/network.operations/inspections",
    "/api/extensions/network.operations/inspections/<task_id>",
    "/api/extensions/network.operations/inspections/<task_id>/cancel",
    "/api/extensions/network.operations/baselines",
    "/api/extensions/network.operations/baselines/<baseline_id>/confirm",
    "/api/extensions/network.operations/diff"
  ],
  "frontend_modules": ["frontend/NetworkOperations.tsx"],
  "frontend_routes": [
    {
      "path": "/extensions/network.operations/overview",
      "module": "frontend/NetworkOperations.tsx",
      "label": "网络巡检",
      "description": "管理设备、巡检和状态基线",
      "icon": "probe",
      "order": 30
    }
  ],
  "entrypoint": "backend.py:register"
}
