AGENT_PLATFORM_LOGIN_USERNAME=Admin
AGENT_PLATFORM_SESSION_SECRET_FILE=/etc/agent-platform/secrets/session-secret
AGENT_PLATFORM_LOGIN_PASSWORD_FILE=/etc/agent-platform/secrets/login-password
AGENT_PLATFORM_API_TOKEN_FILE=/etc/agent-platform/secrets/api-token
AGENT_PLATFORM_APPROVAL_TTL_SECONDS=1800
AGENT_PLATFORM_PYTHON_CONTAINER_IMAGE=python@sha256:replace-with-verified-digest
AGENT_PLATFORM_DOCKER_SOCKET=/var/run/docker.sock
AGENT_PLATFORM_DOCKER_SOCKET_GID=replace-with-stat-c-percent-g
AGENT_PLATFORM_HTTPS_PORT=443
AGENT_PLATFORM_TLS_CERT_FILE=/etc/agent-platform/tls/tls.crt
AGENT_PLATFORM_TLS_KEY_FILE=/etc/agent-platform/tls/tls.key
POSTGRES_PASSWORD=replace-with-a-strong-password
MINIO_ROOT_USER=agent-platform-minio
MINIO_ROOT_PASSWORD=replace-with-a-strong-password
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password

# Optional enterprise OIDC. Users must already exist in 用户与权限.
# AGENT_PLATFORM_OIDC_ENABLED=true
# AGENT_PLATFORM_PUBLIC_URL=https://agent.example.com
# AGENT_PLATFORM_OIDC_ISSUER=https://idp.example.com
# AGENT_PLATFORM_OIDC_CLIENT_ID=agent-platform
# AGENT_PLATFORM_OIDC_CLIENT_SECRET_FILE=/etc/agent-platform/secrets/oidc-client-secret
