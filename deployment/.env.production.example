LZCORE_LOGIN_USERNAME=Admin
LZCORE_SESSION_SECRET_FILE=/etc/lzcore/secrets/session-secret
LZCORE_LOGIN_PASSWORD_FILE=/etc/lzcore/secrets/login-password
LZCORE_API_TOKEN_FILE=/etc/lzcore/secrets/api-token
LZCORE_APPROVAL_TTL_SECONDS=1800
LZCORE_CONTINUATION_STALL_SECONDS=900
LZCORE_CONTINUATION_RETENTION_DAYS=30
LZCORE_PYTHON_CONTAINER_IMAGE=python@sha256:replace-with-verified-digest
LZCORE_DOCKER_SOCKET=/var/run/docker.sock
LZCORE_DOCKER_SOCKET_GID=replace-with-stat-c-percent-g
LZCORE_HTTPS_PORT=443
LZCORE_TLS_CERT_FILE=/etc/lzcore/tls/tls.crt
LZCORE_TLS_KEY_FILE=/etc/lzcore/tls/tls.key
POSTGRES_PASSWORD=replace-with-a-strong-password
MINIO_ROOT_USER=lzcore-minio
MINIO_ROOT_PASSWORD=replace-with-a-strong-password
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password

# Optional enterprise OIDC. Users must already exist in 用户与权限.
# LZCORE_OIDC_ENABLED=true
# LZCORE_PUBLIC_URL=https://agent.example.com
# LZCORE_OIDC_ISSUER=https://idp.example.com
# LZCORE_OIDC_CLIENT_ID=lzcore
# LZCORE_OIDC_CLIENT_SECRET_FILE=/etc/lzcore/secrets/oidc-client-secret
